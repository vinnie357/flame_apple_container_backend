  defp handle_alert_command(options, ["list"]) do
    case api_request("GET", "/alerts", nil, options) do
      {:ok, %{"alerts" => alerts}} ->
        format_and_print_alerts(alerts, options)
      
      {:error, reason} ->
        print_error("Failed to list alerts: #{reason}")
    end
  end
  
  defp handle_alert_command(options, ["ack", alert_id]) do
    ack_data = %{"user_id" => "cli_user", "notes" => "Acknowledged via CLI"}
    
    case api_request("POST", "/alerts/#{alert_id}/acknowledge", ack_data, options) do
      {:ok, _} ->
        print_success("Alert #{alert_id} acknowledged")
      
      {:error, reason} ->
        print_error("Failed to acknowledge alert #{alert_id}: #{reason}")
    end
  end
  
  defp handle_alert_command(options, ["resolve", alert_id]) do
    resolve_data = %{"user_id" => "cli_user", "resolution_notes" => "Resolved via CLI"}
    
    case api_request("POST", "/alerts/#{alert_id}/resolve", resolve_data, options) do
      {:ok, _} ->
        print_success("Alert #{alert_id} resolved")
      
      {:error, reason} ->
        print_error("Failed to resolve alert #{alert_id}: #{reason}")
    end
  end
  
  defp handle_alert_command(_options, args) do
