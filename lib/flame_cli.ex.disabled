defmodule FlameCLI do
  @moduledoc """
  Command-line interface for Apple Containers FLAME backend.
  
  Provides comprehensive CLI tools for:
  - Cluster management and monitoring
  - Job submission and workflow orchestration
  - Container image lifecycle management
  - Alert management and troubleshooting
  - Performance monitoring and analytics
  - Development and debugging utilities
  """
  
  require Logger
  
  @api_base_url "http://localhost:4000/api/v1"
  @version "1.0.0"
  
  def main(args) do
    args
    |> parse_args()
    |> process_command()
  end
  
  defp parse_args(args) do
    {options, command_args, _} = OptionParser.parse(args,
      switches: [
        help: :boolean,
        version: :boolean,
        format: :string,
        output: :string,
        verbose: :boolean,
        config: :string,
        cluster: :string,
        timeout: :integer
      ],
      aliases: [
        h: :help,
        v: :version,
        f: :format,
        o: :output,
        c: :config
      ]
    )
    
    {options, command_args}
  end
  
  defp process_command({options, []}) do
    if options[:help] or options == [] do
      print_help()
    elsif options[:version] do
      print_version()
    else
      print_help()
    end
  end
  
  defp process_command({options, command_args}) when is_list(command_args) do
    if options[:version] do
      print_version()
    else
      dispatch_command({options, command_args})
    end
  end
  
  defp dispatch_command({options, ["cluster" | args]}) do
    handle_cluster_command(options, args)
  end
  
  defp dispatch_command({options, ["job" | args]}) do
    handle_job_command(options, args)
  end
  
  defp dispatch_command({options, ["workflow" | args]}) do
    handle_workflow_command(options, args)
  end
  
  defp dispatch_command({options, ["image" | args]}) do
    handle_image_command(options, args)
  end
  
  defp dispatch_command({options, ["alert" | args]}) do
    handle_alert_command(options, args)
  end
  
  defp dispatch_command({options, ["metrics" | args]}) do
    handle_metrics_command(options, args)
  end
  
  defp dispatch_command({options, ["config" | args]}) do
    handle_config_command(options, args)
  end
  
  defp dispatch_command({options, ["dev" | args]}) do
    handle_dev_command(options, args)
  end
  
  defp dispatch_command({_options, [unknown_command | _]}) do
    IO.puts("Unknown command: #{unknown_command}")
    IO.puts("Use --help to see available commands.")
  end
  
  
  # Cluster Commands
  
  defp handle_cluster_command(options, ["list"]) do
    case api_request("GET", "/clusters", nil, options) do
      {:ok, %{"clusters" => clusters}} ->
        format_and_print_clusters(clusters, options)
      
      {:error, reason} ->
        print_error("Failed to list clusters: #{reason}")
    end
  end
  
  defp handle_cluster_command(options, ["get", cluster_id]) do
    case api_request("GET", "/clusters/#{cluster_id}", nil, options) do
      {:ok, cluster} ->
        format_and_print_cluster_details(cluster, options)
      
      {:error, reason} ->
        print_error("Failed to get cluster #{cluster_id}: #{reason}")
    end
  end
  
  defp handle_cluster_command(options, ["register", cluster_id, endpoints_json]) do
    case Jason.decode(endpoints_json) do
      {:ok, endpoints} ->
        cluster_config = %{
          "id" => cluster_id,
          "endpoints" => endpoints
        }
        
        case api_request("POST", "/clusters", cluster_config, options) do
          {:ok, %{"cluster" => cluster}} ->
            print_success("Cluster #{cluster_id} registered successfully")
            format_and_print_cluster_details(cluster, options)
          
          {:error, reason} ->
            print_error("Failed to register cluster #{cluster_id}: #{reason}")
        end
      
      {:error, _} ->
        print_error("Invalid JSON format for endpoints")
    end
  end
  
  defp handle_cluster_command(options, ["unregister", cluster_id]) do
    case api_request("DELETE", "/clusters/#{cluster_id}", nil, options) do
      {:ok, _} ->
        print_success("Cluster #{cluster_id} unregistered successfully")
      
      {:error, reason} ->
        print_error("Failed to unregister cluster #{cluster_id}: #{reason}")
    end
  end
  
  defp handle_cluster_command(options, ["failover", from_cluster, to_cluster]) do
    failover_config = %{
      "target_cluster_id" => to_cluster
    }
    
    case api_request("POST", "/clusters/#{from_cluster}/failover", failover_config, options) do
      {:ok, _} ->
        print_success("Failover initiated from #{from_cluster} to #{to_cluster}")
      
      {:error, reason} ->
        print_error("Failover failed: #{reason}")
    end
  end
  
  defp handle_cluster_command(_options, ["status"]) do
    case api_request("GET", "/metrics/overview", nil, []) do
      {:ok, %{"clusters" => cluster_metrics}} ->
        print_cluster_status(cluster_metrics)
      
      {:error, reason} ->
        print_error("Failed to get cluster status: #{reason}")
    end
  end
  
  defp handle_cluster_command(_options, args) do
    print_error("Unknown cluster command: #{Enum.join(args, " ")}")
    print_cluster_help()
  end
  
  # Job Commands
  
  defp handle_job_command(options, ["list"]) do
    params = build_job_list_params(options)
    
    case api_request("GET", "/jobs?#{params}", nil, options) do
      {:ok, %{"jobs" => jobs}} ->
        format_and_print_jobs(jobs, options)
      
      {:error, reason} ->
        print_error("Failed to list jobs: #{reason}")
    end
  end
  
  defp handle_job_command(options, ["get", job_id]) do
    case api_request("GET", "/jobs/#{job_id}", nil, options) do
      {:ok, job} ->
        format_and_print_job_details(job, options)
      
      {:error, reason} ->
        print_error("Failed to get job #{job_id}: #{reason}")
    end
  end
  
  defp handle_job_command(options, ["submit", job_spec_file]) do
    case File.read(job_spec_file) do
      {:ok, content} ->
        case Jason.decode(content) do
          {:ok, job_spec} ->
            case api_request("POST", "/jobs", job_spec, options) do
              {:ok, %{"job_id" => job_id}} ->
                print_success("Job submitted successfully: #{job_id}")
              
              {:error, reason} ->
                print_error("Failed to submit job: #{reason}")
            end
          
          {:error, _} ->
            print_error("Invalid JSON in job specification file")
        end
      
      {:error, reason} ->
        print_error("Failed to read job specification file: #{reason}")
    end
  end
  
  defp handle_job_command(options, ["cancel", job_id]) do
    cancel_data = %{"reason" => "cancelled_via_cli"}
    
    case api_request("DELETE", "/jobs/#{job_id}", cancel_data, options) do
      {:ok, _} ->
        print_success("Job #{job_id} cancelled successfully")
      
      {:error, reason} ->
        print_error("Failed to cancel job #{job_id}: #{reason}")
    end
  end
  
  defp handle_job_command(options, ["logs", job_id]) do
    # This would fetch job logs - placeholder for now
    print_info("Job logs for #{job_id}:")
    print_info("(Log streaming not yet implemented)")
  end
  
  defp handle_job_command(options, ["watch"]) do
    print_info("Watching job status (press Ctrl+C to stop)...")
    watch_jobs(options)
  end
  
  defp handle_job_command(_options, args) do
    print_error("Unknown job command: #{Enum.join(args, " ")}")
    print_job_help()
  end
  
  # Workflow Commands
  
  defp handle_workflow_command(options, ["list"]) do
    case api_request("GET", "/workflows", nil, options) do
      {:ok, %{"workflows" => workflows}} ->
        format_and_print_workflows(workflows, options)
      
      {:error, reason} ->
        print_error("Failed to list workflows: #{reason}")
    end
  end
  
  defp handle_workflow_command(options, ["submit", workflow_spec_file]) do
    case File.read(workflow_spec_file) do
      {:ok, content} ->
        case Jason.decode(content) do
          {:ok, workflow_spec} ->
            case api_request("POST", "/workflows", workflow_spec, options) do
              {:ok, %{"workflow_id" => workflow_id}} ->
                print_success("Workflow submitted successfully: #{workflow_id}")
              
              {:error, reason} ->
                print_error("Failed to submit workflow: #{reason}")
            end
          
          {:error, _} ->
            print_error("Invalid JSON in workflow specification file")
        end
      
      {:error, reason} ->
        print_error("Failed to read workflow specification file: #{reason}")
    end
  end
  
  defp handle_workflow_command(_options, args) do
    print_error("Unknown workflow command: #{Enum.join(args, " ")}")
    print_workflow_help()
  end
  
  # Image Commands
  
  defp handle_image_command(options, ["list"]) do
    case api_request("GET", "/images", nil, options) do
      {:ok, %{"images" => images}} ->
        format_and_print_images(images, options)
      
      {:error, reason} ->
        print_error("Failed to list images: #{reason}")
    end
  end
  
  defp handle_image_command(options, ["build", build_spec_file]) do
    case File.read(build_spec_file) do
      {:ok, content} ->
        case Jason.decode(content) do
          {:ok, build_spec} ->
            case api_request("POST", "/images/build", build_spec, options) do
              {:ok, %{"build_id" => build_id}} ->
                print_success("Image build started: #{build_id}")
                
                if options[:verbose] do
                  watch_image_build(build_id, options)
                end
              
              {:error, reason} ->
                print_error("Failed to start image build: #{reason}")
            end
          
          {:error, _} ->
            print_error("Invalid JSON in build specification file")
        end
      
      {:error, reason} ->
        print_error("Failed to read build specification file: #{reason}")
    end
  end
  
  defp handle_image_command(options, ["deploy", image_id]) do
    case api_request("POST", "/images/#{image_id}/deploy", %{}, options) do
      {:ok, %{"deployment_id" => deployment_id}} ->
        print_success("Image deployment started: #{deployment_id}")
      
      {:error, reason} ->
        print_error("Failed to deploy image #{image_id}: #{reason}")
    end
  end
  
  defp handle_image_command(options, ["scan", image_id]) do
    case api_request("POST", "/images/#{image_id}/scan", %{}, options) do
      {:ok, _} ->
        print_success("Security scan started for image #{image_id}")
      
      {:error, reason} ->
        print_error("Failed to start security scan for image #{image_id}: #{reason}")
    end
  end
  
  defp handle_image_command(_options, args) do
    print_error("Unknown image command: #{Enum.join(args, " ")}")
    print_image_help()
  end
  
