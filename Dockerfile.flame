FROM elixir:1.15-alpine

# Install required packages for Erlang distribution
RUN apk add --no-cache bash openssl curl netcat-openbsd

# Set up application directory
WORKDIR /app

# Copy application files
COPY mix.exs mix.lock ./
COPY config config/
COPY lib lib/

# Install dependencies and compile
RUN mix local.hex --force && \
    mix local.rebar --force && \
    mix deps.get && \
    mix compile

# Configure environment
ENV HOME="/root"
ENV ELIXIR_ERL_OPTIONS="+K true +A 4"
ENV ERL_EPMD_ADDRESS="0.0.0.0"

# Copy and setup startup script
COPY start-worker.sh /usr/local/bin/start-worker
RUN chmod +x /usr/local/bin/start-worker

# Health check script
RUN echo '#!/bin/bash\n\
epmd -names | grep -q "name " || exit 1\n\
' > /usr/local/bin/health-check && \
    chmod +x /usr/local/bin/health-check

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD /usr/local/bin/health-check

# Expose EPMD port and beam port range
EXPOSE 4369 9001-9999

# Start the distributed node
CMD ["/usr/local/bin/start-worker"]