# Dockerfile for FLAME Apple Containers Worker
# This creates a container image suitable for running FLAME worker tasks
# with support for distributed Erlang and Apple Containers networking.

FROM elixir:1.15-alpine AS builder

# Install build dependencies
RUN apk add --no-cache \
    build-base \
    git \
    openssl-dev \
    curl

# Set build environment
ENV MIX_ENV=prod

# Create application directory
WORKDIR /app

# Copy mix files and install dependencies
COPY mix.exs mix.lock ./
RUN mix local.hex --force && \
    mix local.rebar --force && \
    mix deps.get --only prod

# Copy application source
COPY lib lib/
COPY config config/

# Compile the application
RUN mix deps.compile && \
    mix compile

# Build release
RUN mix release worker

# Production stage
FROM alpine:3.18

# Install runtime dependencies
RUN apk add --no-cache \
    bash \
    openssl \
    ncurses \
    curl \
    ca-certificates \
    dumb-init

# Create app user and directories
RUN addgroup -g 1001 flame && \
    adduser -u 1001 -G flame -s /bin/bash -D flame

# Create application directories
RUN mkdir -p /app/bin /app/lib /app/releases && \
    chown -R flame:flame /app

# Copy release from builder
COPY --from=builder --chown=flame:flame /app/_build/prod/rel/worker /app/

# Switch to app user
USER flame
WORKDIR /app

# Configure Erlang VM
ENV ELIXIR_ERL_OPTIONS="+K true +A 4 +SDio 4"
ENV ERL_EPMD_ADDRESS="0.0.0.0"
ENV ERL_EPMD_PORT="4369"

# Set default environment variables
ENV MIX_ENV=prod
ENV RELEASE_DISTRIBUTION=name
ENV RELEASE_NODE=worker@worker.flame.local

# Health check script
COPY --chown=flame:flame docker/health-check.sh /usr/local/bin/health-check
RUN chmod +x /usr/local/bin/health-check

# Worker initialization script
COPY --chown=flame:flame docker/worker-init.sh /usr/local/bin/worker-init
RUN chmod +x /usr/local/bin/worker-init

# Expose EPMD port and beam communication port range
EXPOSE 4369 9001-9100

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD /usr/local/bin/health-check

# Use dumb-init to handle signals properly
ENTRYPOINT ["/usr/bin/dumb-init", "--"]

# Start the worker with initialization
CMD ["/usr/local/bin/worker-init"]
