# Example Dockerfile for building a FLAME worker image
#
# Build from the flame_worker/ example app directory:
#   container build -f ../Dockerfile.flame -t flame-worker:latest .
#
# Or copy this Dockerfile into your own application and adapt it.
#
# Requirements:
#   - Elixir release with :flame as a dependency
#   - FLAME.Terminator started in your supervision tree
#   - Distributed Erlang enabled (RELEASE_DISTRIBUTION=name)
#
# The backend sets these env vars on the container at runtime:
#   FLAME_PARENT   - encoded parent info (decoded by FLAME.Terminator)
#   FLAME_HOST     - container hostname for discovery
#   RELEASE_NODE   - full node name (name@host)
#   RELEASE_COOKIE - erlang cookie matching the parent node
#   PHX_SERVER     - "false" (workers don't serve HTTP)

# --- Build stage ---
FROM elixir:1.18-alpine AS builder

RUN apk add --no-cache build-base git

ENV MIX_ENV=prod

WORKDIR /app

COPY mix.exs ./
RUN mix local.hex --force && \
    mix local.rebar --force && \
    mix deps.get --only prod && \
    mix deps.compile

COPY config config/
COPY lib lib/

RUN mix compile && mix release flame_worker

# --- Runtime stage ---
FROM alpine:3.21

RUN apk add --no-cache openssl ncurses ca-certificates

RUN addgroup -g 1001 flame && \
    adduser -u 1001 -G flame -s /bin/sh -D flame

COPY --from=builder --chown=flame:flame /app/_build/prod/rel/flame_worker /app/

USER flame
WORKDIR /app

# The backend sets RELEASE_NODE, RELEASE_COOKIE, FLAME_PARENT at runtime.
# Do NOT hardcode these here.
ENV RELEASE_DISTRIBUTION=name

ENTRYPOINT ["/app/bin/flame_worker"]
CMD ["start"]
