FROM elixir:1.15-alpine

# Install required packages
RUN apk add --no-cache bash openssl curl

# Set up application directory
WORKDIR /app

# Copy application files
COPY mix.exs mix.lock ./
COPY config config/
COPY lib lib/

# Install dependencies and compile
RUN mix local.hex --force && \
    mix local.rebar --force && \
    mix deps.get && \
    mix compile

# Configure environment
ENV HOME="/root"
ENV FLAME_WORKER_PORT=4000

# Copy HTTP worker script
COPY http-worker.sh /usr/local/bin/http-worker
RUN chmod +x /usr/local/bin/http-worker

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:${FLAME_WORKER_PORT}/health || exit 1

# Expose the worker port
EXPOSE 4000

# Start the HTTP worker
CMD ["/usr/local/bin/http-worker"]