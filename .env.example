# FLAME Apple Container Backend - Environment Configuration
# Copy this file to .env and adjust values for your environment.
# Never commit .env to version control.

# --- Core ---
# Erlang distribution cookie for connecting to worker containers
FLAME_ERLANG_COOKIE=change_me_to_a_secure_random_string
# Container image for FLAME workers
FLAME_IMAGE=flame-worker:latest
# DNS domain for container networking
FLAME_DNS_DOMAIN=flame.local
# Container name prefix
FLAME_CONTAINER_PREFIX=flame-worker

# --- Pool ---
# Minimum idle workers
FLAME_POOL_MIN=0
# Maximum workers
FLAME_POOL_MAX=5
# Max concurrent tasks per worker
FLAME_POOL_MAX_CONCURRENCY=10
# Boot timeout in milliseconds
FLAME_BOOT_TIMEOUT=60000
# Idle shutdown after milliseconds
FLAME_IDLE_SHUTDOWN_AFTER=30000

# --- Feature Flags ---
# Enable metrics collection and health checks
FLAME_ENABLE_METRICS=true
# Enable security subsystems (RBAC, audit, policy engine)
FLAME_ENABLE_SECURITY=true
# Enable task orchestration
FLAME_ENABLE_ORCHESTRATION=true
# Enable Phoenix LiveView web dashboard
FLAME_ENABLE_WEB_INTERFACE=false
# Enable HTTP worker server
FLAME_ENABLE_WORKER_SERVER=false
# Start only core processes (disables health, orchestration, optimizer)
FLAME_MINIMAL_MODE=false

# --- Web Dashboard (requires FLAME_ENABLE_WEB_INTERFACE=true) ---
# Port for the Phoenix web dashboard
FLAME_WEB_PORT=4001
# Dashboard feature tier: basic, standard, or premium
FLAME_DASHBOARD_TIER=standard
# Secret key base for Phoenix sessions (min 64 bytes)
SECRET_KEY_BASE=generate_a_64_byte_or_longer_random_string_here
# Signing salt for Phoenix LiveView
LIVE_VIEW_SIGNING_SALT=generate_a_random_salt

# --- HTTP Worker Server (requires FLAME_ENABLE_WORKER_SERVER=true) ---
# Port for the HTTP worker server
FLAME_WORKER_PORT=4000

# --- Logging ---
# Log level: debug, info, warning, error
LOG_LEVEL=info
