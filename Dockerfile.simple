FROM elixir:1.15-alpine

# Install required packages
RUN apk add --no-cache bash openssl curl

# Set up application directory
WORKDIR /app

# Copy application files
COPY mix.exs mix.lock ./
COPY config config/
COPY lib lib/

# Install dependencies and compile
RUN mix local.hex --force && \
    mix local.rebar --force && \
    mix deps.get && \
    mix compile

# Configure environment
ENV HOME="/root"

# Copy simple worker script
COPY simple-worker.sh /usr/local/bin/simple-worker
RUN chmod +x /usr/local/bin/simple-worker

# Start the simple worker
CMD ["/usr/local/bin/simple-worker"]